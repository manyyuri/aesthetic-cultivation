# ---- LLM（缺 key 时自动降级为 stub，可离线跑通全链路）----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=

# ---- embedding ----
# auto   = 用 hashed 兜底（离线可跑，不跨语言）
# bge    = 加载 bge-m3 / 或 EMBED_MODEL 指向的本地目录（多语言，推荐）
EMBED_PROVIDER=auto
# 本地权重目录（先用 scripts/download_models.sh 下好），或直接写 HF 模型 id
EMBED_MODEL=

EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=

# ---- rerank ----
# auto    = lexical（离线可跑）
# bge     = cross-encoder；EMBED_MODEL/RERANK_MODEL 指向本地目录时阈值按目录名取
RERANK_PROVIDER=auto
RERANK_MODEL=

# ---- 开放数据源 ----
# MusicBrainz 硬性要求带联系方式的 User-Agent；不填则 make fetch 拒绝运行
SOURCES_UA_CONTACT=

# ---- auth ----
API_KEYS=dev-local-key
SESSION_SECRET=dev-session-secret

# ---- push ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
PUSH_EMAIL_TO=
